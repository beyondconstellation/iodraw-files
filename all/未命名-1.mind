{"root":{"data":{"id":"cxx2gpbaruo0","created":1703472104348,"text":"思想道德与法治"},"children":[{"data":{"id":"cxx2ki8sljs0","created":1703472402416,"text":"绪论 担当复兴大任，成就时代新人","layout":null},"children":[{"data":{"id":"cxx2lkexfgo0","created":1703472485504,"text":"1.我们处在中国特色社会主义新时代","layout":null},"children":[{"data":{"id":"cxx2m1mjcyw0","created":1703472522970,"text":"是什么","expandState":"expand","layout":null},"children":[{"data":{"id":"cxx2mnbjb800","created":1703472570194,"text":"我们理解当前所处历史方位的关键词","layout":null},"children":[]},{"data":{"id":"cxx2mszu1zc0","created":1703472582547,"text":"承前启后，继往开来，在新的历史条件下夺取中国特色社会主义伟大胜利的时代","layout":null},"children":[]},{"data":{"id":"cxx2o35hlq80","created":1703472683021,"text":"奋力实现中华民族伟大复兴的中国梦的时代","layout":null},"children":[]}]},{"data":{"id":"cxx2pkghvco0","created":1703472799056,"text":"要求","layout":null},"children":[{"data":{"id":"cxx2pnkpidc0","created":1703472805841,"text":"新时代呼唤担当民族复兴大任的时代新人","layout":null},"children":[]},{"data":{"id":"cxx2q8yzabs0","created":1703472852416,"text":"立大志，明大德，成大才，担大任","layout":null},"children":[]}]}]},{"data":{"id":"cxx2om5wwzs0","created":1703472724405,"text":"2.中国梦","layout":null},"children":[{"data":{"id":"cxx2uutratk0","created":1703473213446,"text":"特点","layout":null},"children":[{"data":{"id":"cxx2oumuyjk0","created":1703472742844,"text":"历史的，现实的，也是未来的；国家的，民族的，也是每一个中国人的","layout":null},"children":[]}]}]},{"data":{"id":"cxx2r4p8aps0","created":1703472921484,"text":"3.思想道德素质和法制素养","layout":null},"children":[{"data":{"id":"cxx2rqpqnnk0","created":1703472969404,"text":"二者关系","layout":null},"children":[{"data":{"id":"cxx2rxj34140","created":1703472984239,"text":"思想道德建设为法制建设提供思想指引和道德基础","layout":null},"children":[]},{"data":{"id":"cxx2s9wnmxk0","created":1703473011181,"text":"法治建设为思想道德建设提供制度支撑和法律保障，通过对思想道德的基本原则予以确认，为思想道德建设提供国家强制力保障","layout":null},"children":[]}]}]}]},{"data":{"id":"cxx2hg8f3w00","created":1703472162947,"text":"第一章 领悟人生真谛，把握人生方向","layout":null},"children":[{"data":{"id":"cxx2v7i2p2g0","created":1703473241038,"text":"人的本质","layout":null},"children":[{"data":{"id":"cxx2vc0gjt40","created":1703473250857,"text":"人的本质不是单个人所固有的抽象物，在其现实性上，它是一\n切社会关系的总和（马克思）","layout":null},"children":[]}]},{"data":{"id":"cxx2we5ysls0","created":1703473333908,"text":"人生观","layout":null},"children":[{"data":{"id":"cxx2wgrpou00","created":1703473339576,"text":"主要内容","layout":null},"children":[{"data":{"id":"cxx2wjy6ta80","created":1703473346498,"text":"人生目的、人生态度和人生价值","layout":null},"children":[{"data":{"id":"cxx2x0f21gg0","created":1703473382346,"text":"人生目的：人在社会实践中关于自身行为的\n根本指向和人生追求 ","color":"#c00000","layout":null},"children":[]},{"data":{"id":"cxx2xq9k88o0","created":1703473438611,"text":"人生态度：人们通过生活实践形成的对人生问题的一种相对稳定的心理倾\n向和精神状态","color":"#c00000","layout":null},"children":[]},{"data":{"id":"cxx2y7b0txs0","created":1703473475704,"text":"人生价值：人的生命及其实践活动对于社会和个人所具有的作用和意义","priority":null,"color":"#c00000","font-weight":"bold","layout":null},"children":[{"data":{"id":"cxx30ec96u00","created":1703473647745,"text":"自我价值和社会价值关系","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx30juleh40","created":1703473659737,"text":"既相互区别，又密切联系、相互依存，共同构成人生价值的矛盾统一体","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx30z8wftk0","created":1703473693254,"text":"人生的自我价值是个体生存和发展的必要条件","color":"#c00000","layout":null},"children":[]},{"data":{"id":"cxx313qbtps0","created":1703473703015,"text":"人生的社会价值是社会存在和发展的重要条件，人生社会价值的实\n现是个体自我完善、全面发展的保障","color":"#c00000","layout":null},"children":[]}]}]}]}]}]},{"data":{"id":"cxx31mdycog0","created":1703473743626,"text":"正确的人生观","layout":null},"children":[{"data":{"id":"cxx31uthvj40","created":1703473761980,"text":"高尚的人生追求","layout":null},"children":[{"data":{"id":"cxx32e1vtvc0","created":1703473803846,"text":"最先进的人生追求","layout":null},"children":[{"data":{"id":"cxx3312wpo00","created":1703473853974,"text":"服务社会，奉献社会","layout":null},"children":[]}]},{"data":{"id":"cxx32ibuobk0","created":1703473813156,"text":"作用","layout":null},"children":[{"data":{"id":"cxx33411y1c0","created":1703473860392,"text":"确立了这样的人生追求，才能清楚地把握人生的奋斗目标，深刻理解人为了什么而活、应该走什么样的人生道路等道理","layout":null},"children":[]}]}]},{"data":{"id":"cxx33vbwpeo0","created":1703473919821,"text":"积极进取的人生态度","layout":null},"children":[{"data":{"id":"cxx33y3maxk0","created":1703473925851,"text":"人生应该认真、务实、乐观、进取","layout":null},"children":[]}]},{"data":{"id":"cxx3aequpfs0","created":1703474432269,"text":"人生价值的评价与实现","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx34s169mg0","created":1703473991006,"text":"评价","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx3a5q1eds0","created":1703474412629,"text":"根本尺度","color":"#c00000","expandState":"expand","font-weight":"bold","layout":null},"children":[{"data":{"id":"cxx34zvyyew0","created":1703474008106,"text":"一个人的实践活动是否符合社会发展的客观规律，是否促进了历史的进步","color":"#c00000","font-weight":"bold","layout":null},"children":[]}]},{"data":{"id":"cxx36jvdm9c0","created":1703474129970,"text":"今天的评价标准","layout":null},"children":[{"data":{"id":"cxx36s5g0j40","created":1703474147993,"text":"最重要的就是看一个人是否用自己的劳动和聪明才智为国家和社会真诚贡献，为人民群众尽心尽力服务","layout":null},"children":[]}]},{"data":{"id":"cxx37mjrl6o0","created":1703474214162,"text":"评价方法","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx37re19sg0","created":1703474224699,"text":"坚持尽力程度与社会贡献相统一","color":"#c00000","layout":null},"children":[]},{"data":{"id":"cxx38tl2ok00","created":1703474307843,"text":"坚持物质贡献与精神贡献相统一","color":"#c00000","layout":null},"children":[]},{"data":{"id":"cxx392oyio80","created":1703474327669,"text":"坚持完善自身与贡献社会相统一","color":"#c00000","layout":null},"children":[]}]}]},{"data":{"id":"cxx3by49wfk0","created":1703474552803,"text":"实现","layout":null},"children":[{"data":{"id":"cxx3c5j3inc0","created":1703474568937,"text":"条件","layout":null},"children":[{"data":{"id":"cxx3c81ykew0","created":1703474574431,"text":"实现人生价值要从社会客观条件出发","layout":null},"children":[]},{"data":{"id":"cxx3ccoo9ps0","created":1703474584512,"text":"实现人生价值要从个体自身条件出发","layout":null},"children":[]},{"data":{"id":"cxx3ch2v6fc0","created":1703474594077,"text":"不断增强实现人生价值的能力和本领","layout":null},"children":[]}]}]}]}]},{"data":{"id":"cxx3crymczc0","created":1703474617765,"text":"创造有意义的人生","layout":null},"children":[{"data":{"id":"cxx3d0syqao0","created":1703474637014,"text":"辩证看待人生矛盾","layout":null},"children":[{"data":{"id":"cxx3d8qaujs0","created":1703474654267,"text":"正确看待得与失、苦与乐、顺与逆、生与死、荣与辱","layout":null},"children":[]}]},{"data":{"id":"cxx3dynb8d40","created":1703474710683,"text":"反对错误人生观","layout":null},"children":[{"data":{"id":"cxx3e6gabjs0","created":1703474727672,"text":"反对拜金主义、反对享乐主义、反对极端个人主义","layout":null},"children":[]}]},{"data":{"id":"cxx3ectqzow0","created":1703474741547,"text":"成就出彩人生","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx3ek7p9940","created":1703474757628,"text":"与历史同向，与祖国同行，与人民同在","color":"#c00000","layout":null},"children":[]}]}]}]}]},{"data":{"id":"cxx2inhveig0","created":1703472257120,"text":"第二章 追求远大理想，坚定崇高信念","layout":null},"children":[{"data":{"id":"cxx3fduj0740","created":1703474822135,"text":"内涵及重要性","layout":null},"children":[{"data":{"id":"cxx3g1790c80","created":1703474872970,"text":"理想信念是精神之”钙“","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx3ge04q880","created":1703474900838,"text":"理想信念昭示奋斗目标","layout":null},"children":[]},{"data":{"id":"cxx3gigf7s00","created":1703474910530,"text":"理想信念提供前进动力","layout":null},"children":[]},{"data":{"id":"cxx3ne24mao0","created":1703475449508,"text":"理想信念提供精神支柱"},"children":[]},{"data":{"id":"cxx3gmh57j40","created":1703474919281,"text":"理想信念提高精神境界","layout":null},"children":[]}]},{"data":{"id":"cxx3itwg0ps0","created":1703475092172,"text":"理想","layout":null},"children":[{"data":{"id":"cxx3h5h9kf40","created":1703474960647,"text":"内涵","expandState":"expand","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx3hh0yqqg0","created":1703474985783,"text":"在实践中形成的、有实现可能性的、对未来社会和自身发展目标的向往和追求","color":"#c00000","layout":null},"children":[]}]},{"data":{"id":"cxx3iyo4fkg0","created":1703475102553,"text":"特征","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx3j09oyko0","created":1703475106034,"text":"超越性、实践性、时代性","color":"#c00000","layout":null},"children":[]}]}]},{"data":{"id":"cxx3jgmq9d40","created":1703475141651,"text":"信念","layout":null},"children":[{"data":{"id":"cxx3jllnhp40","created":1703475152469,"text":"内涵","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx3k3vtkoo0","created":1703475192266,"text":"信念是人们在一定的认识基础上确立的对某种思想或事物坚信不疑并身体力行的精神状态","color":"#c00000","layout":null},"children":[]}]},{"data":{"id":"cxx3khaoux40","created":1703475221464,"text":"特征","color":"#c00000","layout":null},"children":[{"data":{"id":"cxx3kr4dk8w0","created":1703475242850,"text":"执着性、支撑性、多样性","color":"#c00000","layout":null},"children":[]}]}]},{"data":{"id":"cxx3mqgg4q00","created":1703475398131,"text":"理想与信念的关系","color":"#c00000"},"children":[{"data":{"id":"cxx3mvjr5400","created":1703475409215,"text":"理想是信念所指的对象，信念则是理想实现的保障","color":"#c00000"},"children":[]}]}]},{"data":{"id":"cxx3nqjrcco0","created":1703475476695,"text":"对马克思主义的信仰"},"children":[{"data":{"id":"cxx3o6ie90o0","created":1703475511442,"text":"为什么信仰马克思主义","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxx3o9dgns00","created":1703475517674,"text":"是科学的理论，创造的揭示了人类社会的发展规律","color":"#c00000"},"children":[]},{"data":{"id":"cxx3om6v0lk0","created":1703475545573,"text":"是人民的理论，第一次创立了人民实现自身解放的思想体系","color":"#c00000"},"children":[]},{"data":{"id":"cxx3oz7lvxc0","created":1703475573916,"text":"是实践的理论，指引着人民改造世界的行动","color":"#c00000"},"children":[{"data":{"id":"cxx3ph2y0dc0","created":1703475612816,"text":"“哲学家们只是用不同的方式解释着世界，问题在于改变世界”（体现时代性）"},"children":[]}]}]},{"data":{"id":"cxx3qlrow200","created":1703475701384,"text":"共产主义伟大理想"},"children":[{"data":{"id":"cxx3r69p3dc0","created":1703475746008,"text":"共产主义是现实运动和长远目标相统一的过程"},"children":[]},{"data":{"id":"cxx3r7wz4pc0","created":1703475749592,"text":"共产主义远大理想的最终实现是一个漫长、艰辛的历史过程，需要一代又一代人付出艰苦的努力"},"children":[]}]}]},{"data":{"id":"cxx3ryrtiao0","created":1703475808054,"text":"实现中国梦"},"children":[{"data":{"id":"cxx3s1qkok80","created":1703475814509,"text":"理想与现实的辩证统一"},"children":[{"data":{"id":"cxx3sr0ccg80","created":1703475869519,"text":"辩证看待理想与现实的矛盾"},"children":[]},{"data":{"id":"cxx3sye05kw0","created":1703475885583,"text":"实现理想的长期性、艰巨性和曲折性"},"children":[]},{"data":{"id":"cxx3t24ccbk0","created":1703475893705,"text":"艰苦奋斗是实现理想的重要条件"},"children":[]}]},{"data":{"id":"cxx3t7z429s0","created":1703475906450,"text":"个人理想与社会理想"},"children":[{"data":{"id":"cxx3te3n50g0","created":1703475919785,"text":"二者含义"},"children":[{"data":{"id":"cxx3tgunr140","created":1703475925772,"text":"个人理想是指处于一定历史条件和社会关系中的个体对于自己未来物质生活、精神生活所产生的向往和追求"},"children":[]},{"data":{"id":"cxx3umg1v0g0","created":1703476016313,"text":"社会理想是指社会集体乃至社会全体成员的共同理想，即全社会占主导地位的共同奋斗目标"},"children":[]}]},{"data":{"id":"cxx3v9ynjdc0","created":1703476067504,"text":"二者关系"},"children":[{"data":{"id":"cxx3veirs0w0","created":1703476077428,"text":"个人理想以社会理想为指引","color":"#c00000"},"children":[]},{"data":{"id":"cxx3vk4pns80","created":1703476089638,"text":"社会理想是对个人理想的凝练和升华","color":"#c00000"},"children":[]},{"data":{"id":"cxx3vnz4of40","created":1703476098008,"text":"坚持个人奋斗目标与国家、民族的奋斗目标相统一，把个人理想融入社会理想\n之中，在为实现社会理想而奋斗的过程中实现个人理想","color":"#c00000"},"children":[]}]}]}]}]},{"data":{"id":"cxx2iwh96jk0","created":1703472276674,"text":"第三章 继承优良传统，弘扬中国精神","layout":null},"children":[{"data":{"id":"cxx5bylg5zc0","created":1703480196062,"text":"中国精神"},"children":[{"data":{"id":"cxx5canz5q00","created":1703480222336,"text":"表现","color":"#c00000"},"children":[{"data":{"id":"cxx5cgisa540","created":1703480235083,"text":"表现在对物质生活与精神生活相互关系的独到理解上"},"children":[]},{"data":{"id":"cxx5dai224w0","created":1703480300342,"text":"表现在中国人对理想的不懈追求上"},"children":[]},{"data":{"id":"cxx5deb3ye00","created":1703480308629,"text":"表现在对品德养成的重视上"},"children":[{"data":{"id":"cxx5ea8kn7c0","created":1703480378133,"text":"“三不朽”之首"},"children":[]}]}]},{"data":{"id":"cxx5evi70hk0","created":1703480424427,"text":"内涵","color":"#c00000"},"children":[{"data":{"id":"cxx5f0ile5k0","created":1703480435335,"text":"伟大创造精神，伟大奋斗精神，伟大团结精神，伟大梦想精神"},"children":[]}]},{"data":{"id":"cxx5fk5iom80","created":1703480478080,"text":"基本内容","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxx5fui5tfk0","created":1703480500612,"text":"以爱国主义为核心的民族精神","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxx9x13apns0","created":1703493131582,"text":"含义"},"children":[{"data":{"id":"cxx9z4qajgg0","created":1703493296231,"text":"民族精神是一个民族在长期共同生活和社会实践中形成的，为本民族大多数成员所认同的价值取向、思维方式道德规范、精神气质的总和，是一个民族赖以生存的精神支柱"},"children":[]}]},{"data":{"id":"cxxa0zeq7340","created":1703493441376,"text":"爱国主义","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxa19vv1gg0","created":1703493464180,"text":"爱祖国的大好河山、爱自己的骨肉同胞、爱祖国的灿烂文化、爱自己的国家","color":"#c00000","font-weight":"bold"},"children":[]},{"data":{"id":"cxxa46310w80","created":1703493690998,"text":"爱国主义是历史的、具体的。现阶段，爱国主义主要表现为献身于建设新时代中国特色社会主义伟大事业，献身于实现中华民族伟大复兴中国梦的实践，献身于促进祖国统一大业","color":"#c00000","font-weight":"bold"},"children":[]},{"data":{"id":"cxxa54yvvds0","created":1703493766935,"text":"本质"},"children":[{"data":{"id":"cxxa582cyw00","created":1703493773676,"text":"坚持爱国、爱党和爱社会主义高度统一"},"children":[{"data":{"id":"cxxa5m2qd8g0","created":1703493804173,"text":"三者统一于实现中华民族伟大复兴的历史进程"},"children":[]}]}]},{"data":{"id":"cxxa6oy2dp40","created":1703493888786,"text":"体现","color":"#c00000"},"children":[{"data":{"id":"cxxa66iltdc0","created":1703493848669,"text":"坚持爱国主义和社会主义相统一、维护祖国统一和民族团结、尊重和传承中华民族历史和文化、坚持立足民族又面向世界。","color":"#c00000"},"children":[]}]}]}]},{"data":{"id":"cxx5iamhm280","created":1703480692431,"text":"以改革创新为核心的时代精神","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxa7q8z4hs0","created":1703493969986,"text":"创新"},"children":[{"data":{"id":"cxxa8jm12tc0","created":1703494033902,"text":"创新决胜未来，创新关乎国运"},"children":[]},{"data":{"id":"cxxa7rwfiqg0","created":1703493973581,"text":"创新是推动人类社会发展的重要力量"},"children":[]},{"data":{"id":"cxxa7yys9i00","created":1703493988961,"text":"创新能力是当今国际竞争新优势的集中体现"},"children":[]},{"data":{"id":"cxxa98b2w540","created":1703494087660,"text":"改革创新是赢得未来的必然要求"},"children":[]}]},{"data":{"id":"cxxa9kolhio0","created":1703494114598,"text":"如何改革创新"},"children":[{"data":{"id":"cxxa9srok5s0","created":1703494132199,"text":"国家层面"},"children":[{"data":{"id":"cxxa9viawsw0","created":1703494138162,"text":"实施创新驱动发展战略"},"children":[{"data":{"id":"cxxafbjrpgg0","created":1703494564900,"text":"把创新摆在国家发展全局的核心位置，最根本的是要增强自主创新能力，最紧迫的是要破除体制机制障碍"},"children":[]},{"data":{"id":"cxxafoovrqw0","created":1703494593508,"text":"最大限度地解放和激发科技作为第一生产力所蕴含的巨大潜化建设全局中的核心地位"},"children":[]},{"data":{"id":"cxxag92j6vs0","created":1703494637869,"text":"打通从科技强到产业强、经济强、国家强的通道，让改革释放创新活力，让一切创新源泉充分涌流"},"children":[]},{"data":{"id":"cxxagfxh3ps0","created":1703494652800,"text":"全面深化改革，坚持创新在我国现代包容创新的良好氛围"},"children":[]}]}]},{"data":{"id":"cxxabdpm6uo0","created":1703494256151,"text":"个人层面"},"children":[{"data":{"id":"cxxaaqapeg00","created":1703494205183,"text":"做改革创新主力军"},"children":[{"data":{"id":"cxxaat4bccg0","created":1703494211327,"text":"增强改革创新的责任感"},"children":[]},{"data":{"id":"cxxab3p6tr40","created":1703494234357,"text":"树立敢于突破陈规的意识"},"children":[]},{"data":{"id":"cxxabuleu4g0","created":1703494292902,"text":"树立大胆探索未知领域的信心"},"children":[]}]},{"data":{"id":"cxxabolmehs0","created":1703494279854,"text":"增强改革创新的能力本领"},"children":[{"data":{"id":"cxxac0crihk0","created":1703494305440,"text":"夯实创新基础"},"children":[]},{"data":{"id":"cxxac23o4w00","created":1703494309243,"text":"培养创新思维"},"children":[]},{"data":{"id":"cxxachvsdmw0","created":1703494343595,"text":"投身改革创新实践"},"children":[]}]}]}]}]}]}]}]},{"data":{"id":"cxx2jh5vhyw0","created":1703472321698,"text":"第四章 明确价值要求，践行价值准则","layout":null},"children":[{"data":{"id":"cxxagq5b4t40","created":1703494675042,"text":"价值观"},"children":[{"data":{"id":"cxxah5sqkyw0","created":1703494709110,"text":"含义"},"children":[{"data":{"id":"cxxahcx2p080","created":1703494724610,"text":"主体对客体有无价值、价值大小的立场和态度，是对价值及其相关内容的基本观点和看法"},"children":[]}]},{"data":{"id":"cxxai45c0dc0","created":1703494783883,"text":"特点"},"children":[{"data":{"id":"cxxaia7idjc0","created":1703494797075,"text":"反映着特定的时代精神"},"children":[]},{"data":{"id":"cxxaikzqkhs0","created":1703494820549,"text":"体现着鲜明的民族特色"},"children":[]},{"data":{"id":"cxxaip8qprk0","created":1703494829801,"text":"蕴含着特定的阶级立场"},"children":[]},{"data":{"id":"cxxaix68q940","created":1703494847064,"text":"是一定社会形态、社会性质的集中体现，在一个社会的思想体系中处于主导地位，体现着社会制度的阶级属性、社会运行的基本原则和社会发展的基本方向"},"children":[]}]}]},{"data":{"id":"cxxak9hd3ts0","created":1703494952222,"text":"社会主义核心价值观"},"children":[{"data":{"id":"cxxakf691540","created":1703494964611,"text":"内容"},"children":[{"data":{"id":"cxxaklgvjm80","created":1703494978314,"text":"富强民主文明和谐","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxam2zik140","created":1703495094811,"text":"从国家层面标注了社会主义核心价值观的时代刻度"},"children":[]}]},{"data":{"id":"cxxal7z4bwg0","created":1703495027306,"text":"自由平等公正法治","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxalt5785k0","created":1703495073387,"text":"揭示了社会主义社会发展的价值取向"},"children":[{"data":{"id":"cxxapx8ikko0","created":1703495395751,"text":"收到法律制约的自由"},"children":[]},{"data":{"id":"cxxaq6twmg00","created":1703495416635,"text":"兼顾效率和公平的平等"},"children":[]},{"data":{"id":"cxxaqlzke200","created":1703495449629,"text":"兼顾程序正义和结果正义的公正"},"children":[]},{"data":{"id":"cxxar10z3oo0","created":1703495482366,"text":"法治是人类政治文明的重要成果，是现代社会的主要特征"},"children":[]}]}]},{"data":{"id":"cxxalgysl1s0","created":1703495046878,"text":"爱国敬业诚信友善","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxam84auao0","created":1703495105984,"text":"回答了我们要培育什么样的公民的重大问题，涵盖了社会公德、职业道德、家庭美德、个人品德等各个方面，是每一个公民都应当遵守的道德规范"},"children":[]}]}]},{"data":{"id":"cxxamjsw2i80","created":1703495131415,"text":"是什么"},"children":[{"data":{"id":"cxxammo3y540","created":1703495137657,"text":"社会主义核心价值体系的精神内核"},"children":[]},{"data":{"id":"cxxamucwdag0","created":1703495154393,"text":"体现了社会主义核心价值体系的根本性特征"},"children":[]},{"data":{"id":"cxxanlqp9so0","created":1703495214001,"text":"反映了社会主义核心价值体系的丰富内涵和实践要求"},"children":[]},{"data":{"id":"cxxao5bm74w0","created":1703495256624,"text":"社会主义核心价值体系的高度凝练和集中表达"},"children":[]}]},{"data":{"id":"cxxasosa4kg0","created":1703495612447,"text":"显著特征"},"children":[{"data":{"id":"cxxasrl9yw00","created":1703495618554,"text":"体现社会主义的本质属性"},"children":[{"data":{"id":"cxxasxl417s0","created":1703495631605,"text":"社会主义是社会主义核心价值观的“底色”"},"children":[]},{"data":{"id":"cxxat6imqjk0","created":1703495651046,"text":"社会主义核心价值观遵循着人类历史发展的轨迹"},"children":[]}]},{"data":{"id":"cxxaur96xfs0","created":1703495774552,"text":"尊重人民群众历史主题地位"},"children":[]},{"data":{"id":"cxxavalobog0","created":1703495816665,"text":"体现以人民为中心的价值导向"},"children":[]},{"data":{"id":"cxxawo7vvow0","created":1703495924671,"text":"具有强大的道义力量"},"children":[{"data":{"id":"cxxax3sheio0","created":1703495958568,"text":"先进性","color":"#c00000"},"children":[{"data":{"id":"cxxax4xi58g0","created":1703495961048,"text":"体现在它是社会主义制度所坚持和追求的核心价值理念","color":"#c00000"},"children":[]}]},{"data":{"id":"cxxaxf5slmg0","created":1703495983317,"text":"人民性","color":"#c00000"},"children":[{"data":{"id":"cxxaxixq57k0","created":1703495991537,"text":"体现在它所代表的最广大人民的根本利益，反映的最广大人民的价值诉求，引导着最广大人民为实现美好社会理想而奋斗","color":"#c00000"},"children":[]}]},{"data":{"id":"cxxaxpkbyds0","created":1703496005964,"text":"真实性","color":"#c00000"},"children":[]}]},{"data":{"id":"cxxavl8odxk0","created":1703495839824,"text":"与西方从抽象的“人性论”出发，将人看作无差别的符号的“普世价值”不同"},"children":[]}]},{"data":{"id":"cxxayeeulmg0","created":1703496060052,"text":"积极践行","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxayls517k0","created":1703496076093,"text":"扣好人生的扣子","color":"#c00000"},"children":[{"data":{"id":"cxxayrcv25k0","created":1703496088230,"text":"青年的价值取向决定了未来整个社会的价值取向"},"children":[]},{"data":{"id":"cxxayvtot340","created":1703496097956,"text":"大学生成长成才和全面发展，离不开正确价值观的引领"},"children":[]},{"data":{"id":"cxxayzc3otc0","created":1703496105599,"text":"核心价值观的养成绝非一日之功"},"children":[]}]},{"data":{"id":"cxxaz2frvhc0","created":1703496112351,"text":"落细落小落实","color":"#c00000"},"children":[{"data":{"id":"cxxaza0vzko0","created":1703496128865,"text":"勤学、修德、明辨、笃实"},"children":[]}]}]}]}]},{"data":{"id":"cxx2jqa216g0","created":1703472341542,"text":"第五章 遵守道德规范，锤炼道德品质","layout":null},"children":[{"data":{"id":"cxxb038f3ig0","created":1703496192447,"text":"社会主义道德"},"children":[{"data":{"id":"cxxb2dxezcg0","created":1703496372455,"text":"道德"},"children":[{"data":{"id":"cxxb2omjvxs0","created":1703496395743,"text":"道德是一种特殊的社会意识形式。它是以善恶为评价式，主要依靠社会舆论、传统习俗和内心信念来发挥作用的行为规范的总和"},"children":[]},{"data":{"id":"cxxb18zzdeg0","created":1703496283362,"text":"道德的起源"},"children":[{"data":{"id":"cxxb0zx1gww0","created":1703496263593,"text":"劳动是道德起源的主要前提"},"children":[]},{"data":{"id":"cxxb1bo98m80","created":1703496289183,"text":"社会关系是道德赖以产生的客观条件"},"children":[]},{"data":{"id":"cxxb1m2o5ts0","created":1703496311823,"text":"人的自我意识是道德产生的客观条件"},"children":[]}]},{"data":{"id":"cxxb2g93jqg0","created":1703496377515,"text":"道德的含义"},"children":[{"data":{"id":"cxxb2ko4vo80","created":1703496387131,"text":"道德是反映社会经济关系的特殊意识形态"},"children":[]},{"data":{"id":"cxxb2w5a2f40","created":1703496412112,"text":"道德是社会利益关系的特殊调节方式"},"children":[]},{"data":{"id":"cxxb32adafc0","created":1703496425481,"text":"道德是一种实践精神"},"children":[]}]},{"data":{"id":"cxxb3eb61uw0","created":1703496451651,"text":"道德的功能和作用","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxb3r0kuco0","created":1703496479308,"text":"功能","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxb3vz114o0","created":1703496490099,"text":"认识功能、规范功能、调节功能是道德最基本的功能，此外还有导向功能、激励功能","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxb49xs83k0","created":1703496520498,"text":"的认识功能是指道德反映社会关系特别是反映社会经济关系的功效与能力","color":"#c00000"},"children":[]},{"data":{"id":"cxxb4qfbsnk0","created":1703496556388,"text":"道德的规范功能是在正确善恶观的指引下，规范社会成员在社会公共领域、职业领域、家庭领域的行为，并规范个人品德的养成","color":"#c00000"},"children":[]},{"data":{"id":"cxxb5244ji80","created":1703496581832,"text":"道德的调节功能是道德最突出最重要的功能。是指道德通过评价等方式，指导和纠正人们的行为和实践活动，协调社会关系和人际关系的功效与能力。道德评价是道德调节的主要形式，社会舆论、传统习惯和人们的内心信念是道德调节所赖以发挥作用的力量","color":"#c00000","font-weight":"bold"},"children":[]}]}]},{"data":{"id":"cxxb5mzdqrk0","created":1703496627257,"text":"作用"},"children":[{"data":{"id":"cxxb622rysg0","created":1703496660114,"text":"道德的作用是指道德的认识、规范、调节、激励、导向、教育等功能的发挥和实现所产生的社会影响及实际效果"},"children":[]},{"data":{"id":"cxxb7mgp7vk0","created":1703496782856,"text":"道德发挥作用的性质与社会发展的不同历史阶段相联系，由道德所反映的经济基础、代表的阶级利益所决定"},"children":[]}]}]}]},{"data":{"id":"cxxb8fk53a80","created":1703496846191,"text":"坚持以“为人民服务”为核心"},"children":[{"data":{"id":"cxxb8z9n6pk0","created":1703496889092,"text":"核心问题"},"children":[{"data":{"id":"cxxb966zzb40","created":1703496904169,"text":"为什么人服务"},"children":[]},{"data":{"id":"cxxb9aky49s0","created":1703496913720,"text":"决定并体现着道德建设的根本性质和发展方向，规定并制约着道德领域中的所有道德现象"},"children":[]}]},{"data":{"id":"cxxb9xnkolk0","created":1703496963945,"text":"是什么"},"children":[{"data":{"id":"cxxba8aepts0","created":1703496987093,"text":"为人民服务是社会主义经济基础和人际关系的客观要求"},"children":[]},{"data":{"id":"cxxbakjfcg00","created":1703497013760,"text":"为人民服务是社会主义市场经济健康发展的要求"},"children":[]},{"data":{"id":"cxxbazbt04g0","created":1703497045951,"text":"为人民服务是先进性要求和广泛性要求的统一"},"children":[]},{"data":{"id":"cxxbbewpn140","created":1703497079867,"text":"为人民服务是社会主义道德区别于和优越于其他社会形态道德的显著标志"},"children":[]}]}]},{"data":{"id":"cxxbbu6q1q00","created":1703497113124,"text":"坚持以集体主义为原则"},"children":[{"data":{"id":"cxxbcaw1k1s0","created":1703497149483,"text":"集体主义特点"},"children":[{"data":{"id":"cxxbcfqxo1c0","created":1703497160058,"text":"强调国家利益、社会利益和个人利益的辩证统一"},"children":[]},{"data":{"id":"cxxbcn8vjts0","created":1703497176381,"text":"强调国家利益、社会整体利益高于个人利益"},"children":[]},{"data":{"id":"cxxbcytcjow0","created":1703497201563,"text":"重视和保障个人的正当利益"},"children":[]}]},{"data":{"id":"cxxbd9njg9c0","created":1703497225156,"text":"层次"},"children":[{"data":{"id":"cxxbdfncqf40","created":1703497238206,"text":"无私奉献、一心为公"},"children":[]},{"data":{"id":"cxxbdn3hrmw0","created":1703497254419,"text":"先公后私、先人后己"},"children":[]},{"data":{"id":"cxxbds8nyk00","created":1703497265616,"text":"顾全大局、遵纪守法、热爱祖国、诚实劳动，以合法手段保障个人利益"},"children":[]}]}]}]},{"data":{"id":"cxxbefg80kg0","created":1703497316139,"text":"借鉴优秀道德成果"},"children":[{"data":{"id":"cxxbel1qhy80","created":1703497328324,"text":"传统中华美德","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxbesyanvk0","created":1703497345530,"text":"特点","color":"#c00000"},"children":[{"data":{"id":"cxxbewj2wd40","created":1703497353317,"text":"注重整体利益、强调责任奉献","color":"#c00000"},"children":[]},{"data":{"id":"cxxbezlwjds0","created":1703497360018,"text":"推崇仁爱原则，注重以和为贵","color":"#c00000"},"children":[]},{"data":{"id":"cxxbf6gh8s00","created":1703497374927,"text":"提倡人伦价值，重视道德义务","color":"#c00000"},"children":[]},{"data":{"id":"cxxbf9nrktc0","created":1703497381898,"text":"追求精神境界，向往理想人格","color":"#c00000"},"children":[]},{"data":{"id":"cxxbfcy0vag0","created":1703497389049,"text":"强调道德修养，注重道德践履","color":"#c00000"},"children":[]}]},{"data":{"id":"cxxbg7t4jgg0","created":1703497456233,"text":"创造性转化和创新性发展"},"children":[{"data":{"id":"cxxbgazqfr40","created":1703497463163,"text":"中国传统道德是一个矛盾体，要在去粗取精、去伪存真的基础上坚持古为今用，推陈出新，努力实现中华传统美德的创造性转化和创新性发展"},"children":[]}]}]},{"data":{"id":"cxxbfvxv27k0","created":1703497430398,"text":"中国革命道德","color":"#c00000"},"children":[{"data":{"id":"cxxbgh663wo0","created":1703497476613,"text":"形成与发展","color":"#c00000"},"children":[{"data":{"id":"cxxbgndewfk0","created":1703497490112,"text":"中国革命道德是指中国共产党人、人民军队、一切先进分子和人民群众在中国新民主主义革命和社会主义革命、建设与改革中所形成的优秀道德"},"children":[]}]},{"data":{"id":"cxxbh5ljdq00","created":1703497529785,"text":"主要内容（具体要求）","color":"#c00000","font-weight":"bold"},"children":[{"data":{"id":"cxxbhd49r540","created":1703497546155,"text":"为实现社会主义和共产主义理想而奋斗","color":"#c00000"},"children":[]},{"data":{"id":"cxxbhnsd6ao0","created":1703497569380,"text":"全心全意为人民服务","color":"#c00000"},"children":[]},{"data":{"id":"cxxbhse8hb40","created":1703497579409,"text":"始终把革命利益放在首位","color":"#c00000"},"children":[]},{"data":{"id":"cxxbhxdprxs0","created":1703497590262,"text":"树立社会新风，建立新型人际关系","color":"#c00000"},"children":[]},{"data":{"id":"cxxbi0su8tc0","created":1703497597707,"text":"修身自律，保持节操","color":"#c00000"},"children":[]}]},{"data":{"id":"cxxbi6qwn2o0","created":1703497610650,"text":"当代价值"},"children":[{"data":{"id":"cxxbifyeih40","created":1703497630695,"text":"有利于加强和巩固社会主义和共产主义的理想信念"},"children":[]},{"data":{"id":"cxxbihbrq2w0","created":1703497633680,"text":"有利于培育和践行社会主义核心价值观"},"children":[]},{"data":{"id":"cxxbilvnvpc0","created":1703497643590,"text":"有利于引导人们树立正确的道德观"},"children":[]},{"data":{"id":"cxxbiouvvq00","created":1703497650073,"text":"有利于培育良好的社会道德风尚"},"children":[]}]}]}]},{"data":{"id":"cxxbiwwqns80","created":1703497667600,"text":"道德实践"},"children":[{"data":{"id":"cxxbj6gzg880","created":1703497688415,"text":"公共生活中的道德规范","color":"#c00000"},"children":[{"data":{"id":"cxxbjbzed9c0","created":1703497700413,"text":"主要内容","color":"#c00000"},"children":[{"data":{"id":"cxxbjdt5wds0","created":1703497704389,"text":"文明礼貌、助人为乐、爱护公物、保护环境、遵纪守法","color":"#c00000"},"children":[]}]}]},{"data":{"id":"cxxbjy69wpk0","created":1703497748717,"text":"网络生活中的道德要求","color":"#c00000"},"children":[{"data":{"id":"cxxbkdvrqzk0","created":1703497782910,"text":"主要内容","color":"#c00000"},"children":[{"data":{"id":"cxxbkia8kl40","created":1703497792492,"text":"正确使用网络工具、健康进行网络交往、自觉避免沉迷网络、加强网络道德自律、积极引导网络舆论","color":"#c00000"},"children":[]}]}]},{"data":{"id":"cxxbkvh6o5c0","created":1703497821210,"text":"职业生活中的道德规范"},"children":[{"data":{"id":"cxxbl8lbyl40","created":1703497849759,"text":"主要内容"},"children":[{"data":{"id":"cxxbla285zk0","created":1703497852958,"text":"爱岗敬业、诚实守信、办事公道、热情服务、奉献社会"},"children":[]}]},{"data":{"id":"cxxblmbqau80","created":1703497879654,"text":"正确的择业观和创业观"},"children":[{"data":{"id":"cxxblu8j1jk0","created":1703497896874,"text":"树立崇高的职业理想，服从社会发展的需要，做好充分的择业准备，培养创业的勇气和能力","color":"#c00000"},"children":[]}]}]},{"data":{"id":"cxxbmkha8v40","created":1703497954000,"text":"弘扬家庭美德"},"children":[{"data":{"id":"cxxbn2e6als0","created":1703497992994,"text":"主要内容"},"children":[{"data":{"id":"cxxbn4pukjs0","created":1703497998054,"text":"尊老爱幼、男女平等、夫妻和睦、勤俭持家、邻里互助"},"children":[]}]},{"data":{"id":"cxxbmswp8ig0","created":1703497972347,"text":"注重家庭、注重家教、注重家风"},"children":[]}]},{"data":{"id":"cxxbnnog74g0","created":1703498039328,"text":"锤炼个人品德"},"children":[{"data":{"id":"cxxbntiqa140","created":1703498052043,"text":"是什么"},"children":[{"data":{"id":"cxxbnueqbq80","created":1703498053978,"text":"个人品德是通过社会道德教育和个人自觉的道德修养所形成的稳定的心理状态和行为习惯"},"children":[]}]},{"data":{"id":"cxxbo016oyo0","created":1703498066219,"text":"怎么做"},"children":[{"data":{"id":"cxxbobl9asg0","created":1703498091378,"text":"形成正确的道德认知和道德判断"},"children":[]},{"data":{"id":"cxxboim8p5s0","created":1703498106675,"text":"激发正向的道德认同和道德情感"},"children":[]},{"data":{"id":"cxxbosjh4800","created":1703498128275,"text":"强化坚定的道德意志和道德信念"},"children":[]}]}]}]}]},{"data":{"id":"cxx2jzfppm80","created":1703472361475,"text":"第六章 学习法治思想，提升法制素养","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}