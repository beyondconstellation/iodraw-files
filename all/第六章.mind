{"root":{"data":{"id":"djd2eh7fdkg0","created":1781876216519,"text":"推动高质量发展"},"children":[{"data":{"id":"djd2flcabzk0","created":1781876303885,"text":"高质量发展是新时代我国经济社会发展的鲜明主题， 是全面建设社会主义现代化国家的首要任务"},"children":[]},{"data":{"id":"djd2f8h7maw0","created":1781876275884,"text":"完整、准确、全面贯彻新发展理念"},"children":[]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}