{"root":{"data":{"id":"djd143jk9pc0","created":1781872582027,"text":"坚持以人民为中心"},"children":[{"data":{"id":"djd17q1trhs0","created":1781872866113,"text":"人民性是马克思主义的本质属性和鲜明品格"},"children":[]},{"data":{"id":"djd1qziiu2w0","created":1781874375632,"text":"打江山、守江山，守的是人民的心"},"children":[]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}