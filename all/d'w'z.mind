{"root":{"data":{"id":"djd2014ny140","created":1781875084426,"text":"全面深化改革开放"},"children":[{"data":{"id":"djd20c38xx40","created":1781875108284,"text":"改革开放是决定当代中国命运的关键一招","layout_mind_offset":{"x":58.00000002949997,"y":0}},"children":[{"data":{"id":"djd26q0vn2o0","created":1781875608801,"text":"改革开放是我们前进的重要法宝"},"children":[{"data":{"id":"djd26v6p3pk0","created":1781875620037,"text":"改革开放是党和人民大踏步赶上时代的重要法宝"},"children":[]},{"data":{"id":"djd26wog28g0","created":1781875623287,"text":"改革开放是坚持和发展中国特色社会主义的必由之路"},"children":[]},{"data":{"id":"djd26y97w7c0","created":1781875626720,"text":"全面深化改革开放是完成新时代目标任务的必然要求"},"children":[]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}